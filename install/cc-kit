#!/usr/bin/env bash
# cc-kit: create and open Control Centers from this kit. Installed into
# ~/.local/bin by install/install.sh; works on macOS, Linux and WSL2. In Git Bash
# on Windows it hands over to install/windows/cc-kit.ps1.
set -euo pipefail

# Git Bash on Windows: the native Windows cc-kit does the work (decision 0033), so no WSL is needed.
case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*)
    windows_kit="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/windows/cc-kit.ps1"
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$windows_kit")" "$@"
    ;;
esac

# Resolve the ~/.local/bin symlink back to the kit clone.
self="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
kit_root="$(cd -- "$(dirname -- "$self")/.." && pwd)"
projects_root="${CC_PROJECTS_ROOT:-$HOME/Projects}"

usage() {
  printf '%s\n' \
    'Usage: cc-kit <command> [arguments]' \
    '' \
    'Commands:' \
    '  new <name> [tool]        Create ~/Projects/<name>_CC and start its setup interview' \
    '  open <name> [tool]       Open a CC (an unfinished setup continues by itself)' \
    '  migrate <folder> [tool]  Turn an existing control center, catalog or docs folder into a CC' \
    '  list                     List Control Centers under ~/Projects' \
    '  doctor                   Check prerequisites and AI tools' \
    '  update                   Update the kit itself (existing CCs are not changed)' \
    '' \
    'tool: claude, codex, opencode, code, cursor or none.' \
    'Default: $CC_KIT_TOOL, else the first installed of claude, codex, opencode.' \
    "Projects root: $projects_root (set CC_PROJECTS_ROOT to change it)"
}

# Opening prompts, so nobody has to know them. Claude Code also starts setup by itself
# (the session-start hook), and AGENTS.md tells every other tool to do the same.
setup_prompt='Set up this Control Center. Use the grill-cc-bootstrap skill.'
continue_prompt='Continue setting up this Control Center. Use the grill-cc-bootstrap skill.'
migrate_prompt='Migrate this folder to the Control Center format. Read cc_template/BOOTSTRAP.md, treat cc_template as read-only, and use the grill-cc-bootstrap skill.'

default_tool() {
  if [[ -n "${CC_KIT_TOOL:-}" ]]; then
    printf '%s' "$CC_KIT_TOOL"
    return
  fi
  local tool
  for tool in claude codex opencode; do
    command -v "$tool" >/dev/null && { printf '%s' "$tool"; return; }
  done
  printf 'none'
}

cc_status() {
  python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("status","unknown"))' "$1/control-center.json" 2>/dev/null || echo unknown
}

# launch <folder> <tool> [prompt]: start the tool in the folder with the opening prompt, where the tool takes one.
launch() {
  local folder="$1" tool="$2" prompt="${3:-}"
  case "$tool" in
    none)
      printf 'Open %s in your AI tool (see %s/GUIDE.md).\n' "$folder" "$kit_root"
      [[ -z "$prompt" ]] || printf 'If the agent does not start on its own, tell it: %s\n' "$prompt"
      return
      ;;
    claude | codex | opencode | code | cursor) ;;
    *)
      printf 'error: unknown tool: %s (claude, codex, opencode, code, cursor or none)\n' "$tool" >&2
      exit 2
      ;;
  esac
  if ! command -v "$tool" >/dev/null; then
    printf 'error: %s is not installed. Install it with: %s/install/install.sh --tools %s\n' "$tool" "$kit_root" "$tool" >&2
    exit 1
  fi
  case "$tool" in
    claude | codex | opencode)
      if [[ ! -t 0 || ! -t 1 ]]; then
        printf 'Not in an interactive terminal. Run: cd %s && %s\n' "$folder" "$tool"
        return
      fi
      cd "$folder"
      # Claude Code and Codex take the first message as an argument and stay interactive.
      if [[ -n "$prompt" && "$tool" != opencode ]]; then
        exec "$tool" "$prompt"
      fi
      exec "$tool"
      ;;
    code | cursor)
      [[ -z "$prompt" ]] || printf 'If the agent chat does not start on its own, tell it: %s\n' "$prompt"
      exec "$tool" "$folder"
      ;;
  esac
}

ok() { printf '  ok    %s\n' "$1"; }
warn() { printf '  warn  %s\n' "$1"; }
bad() { printf '  FAIL  %s\n' "$1"; failures=$((failures + 1)); }

is_wsl() { grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; }

cc_dir() {
  local name="${1:?name is required}"
  name="${name%_CC}"
  if [[ ! "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    printf 'error: name must use lowercase letters, digits and dashes: %s\n' "$name" >&2
    exit 2
  fi
  printf '%s/%s_CC' "$projects_root" "$name"
}

command_new() {
  local target
  target="$(cc_dir "${1:-}")"
  if [[ -e "$target" ]] && [[ -n "$(ls -A "$target" 2>/dev/null)" ]]; then
    printf 'error: %s already exists and is not empty.\n' "$target" >&2
    printf 'To turn an existing folder into a CC: cc-kit migrate <folder>\n' >&2
    exit 1
  fi
  if is_wsl && [[ "$projects_root" == /mnt/* ]]; then
    warn "$projects_root is on the Windows drive; Nix is slow and unreliable there. Use a Linux path such as ~/Projects."
  fi

  mkdir -p "$projects_root"
  python3 "$kit_root/scripts/materialize-template.py" "$target"
  # Nix flakes only see files git knows about, so stage everything now.
  git -C "$target" add -A

  printf '\nCreated %s\n' "$target"
  printf 'Starting the setup interview: the agent asks about your repos and sets everything up.\n'
  printf 'Stop any time; "cc-kit open %s" continues where you left off.\n\n' "$(basename "$target" _CC)"
  launch "$target" "${2:-$(default_tool)}" "$setup_prompt"
}

command_list() {
  shopt -s nullglob
  local found=0
  for directory in "$projects_root"/*_CC; do
    [[ -f "$directory/control-center.json" ]] || continue
    status="$(cc_status "$directory")"
    [[ "$status" == ready ]] || status="$status (setup not finished: cc-kit open $(basename "$directory" _CC))"
    printf '%-40s %s\n' "$(basename "$directory")" "$status"
    found=1
  done
  [[ $found -eq 1 ]] || printf 'No Control Centers in %s yet. Create one with: cc-kit new <name>\n' "$projects_root"
}

command_open() {
  local target prompt=''
  target="$(cc_dir "${1:-}")"
  [[ -f "$target/control-center.json" ]] || { printf 'error: no Control Center at %s; see cc-kit list\n' "$target" >&2; exit 1; }
  case "$(cc_status "$target")" in
    discovery) prompt="$setup_prompt" ;;
    adapting) prompt="$continue_prompt" ;;
  esac
  launch "$target" "${2:-$(default_tool)}" "$prompt"
}

command_migrate() {
  local folder="${1:?usage: cc-kit migrate <folder> [tool]}"
  # A Windows path, as typed from PowerShell through the cc-kit.cmd launcher.
  if [[ "$folder" =~ ^[A-Za-z]:[\\/] ]] && command -v wslpath >/dev/null; then
    folder="$(wslpath -a "$folder")"
  fi
  [[ -d "$folder" ]] || { printf 'error: %s is not a folder\n' "$folder" >&2; exit 1; }
  folder="$(cd -- "$folder" && pwd)"
  if [[ -f "$folder/control-center.json" && -f "$folder/cc" ]]; then
    printf 'error: %s is already a Control Center; use cc-kit open\n' "$folder" >&2
    exit 1
  fi
  if is_wsl && [[ "$folder" == /mnt/* ]]; then
    warn "$folder is on the Windows drive; Nix is slow and unreliable there. Move it under ~/Projects first."
  fi
  if [[ -d "$folder/cc_template" ]]; then
    printf 'Reusing %s/cc_template\n' "$folder"
  else
    # The agent reads the template from here and says when it can be deleted.
    git clone --quiet "$kit_root" "$folder/cc_template"
  fi
  printf 'Starting the migration interview. Nothing is changed before a read-only inventory.\n\n'
  launch "$folder" "${2:-$(default_tool)}" "$migrate_prompt"
}

command_doctor() {
  failures=0
  printf 'System\n'
  case "$(uname -s)" in
    Darwin) ok "macOS $(sw_vers -productVersion 2>/dev/null)" ;;
    Linux)
      if is_wsl; then ok "WSL2 ($(. /etc/os-release && echo "$PRETTY_NAME"))"; else ok "Linux"; fi
      ;;
    MINGW* | MSYS* | CYGWIN*) bad "this is Git Bash on Windows; open Ubuntu (WSL) and run cc-kit there" ;;
    *) bad "unsupported system: $(uname -s)" ;;
  esac
  if is_wsl && [[ "$projects_root" == /mnt/* ]]; then
    bad "projects root is on the Windows drive ($projects_root); use a Linux path"
  else
    ok "projects root: $projects_root"
  fi

  printf '\nRequired\n'
  command -v git >/dev/null && ok "git $(git --version | awk '{print $3}')" || bad "git is missing"
  if command -v python3 >/dev/null && python3 -c 'import sys; sys.exit(sys.version_info < (3, 8))'; then
    ok "python $(python3 -c 'import platform; print(platform.python_version())')"
  else
    bad "python 3.8+ is missing"
  fi
  if command -v nix >/dev/null; then
    ok "$(nix --version)"
    if nix config show experimental-features 2>/dev/null | grep -qw flakes; then
      ok "Nix flakes enabled"
    else
      bad "Nix flakes are disabled; re-run install.sh"
    fi
  else
    bad "Nix is missing; re-run install.sh (open a new terminal first if you just installed it)"
  fi

  printf '\nOptional\n'
  if command -v docker >/dev/null && docker info >/dev/null 2>&1; then
    ok "docker $(docker version --format '{{.Server.Version}}' 2>/dev/null)"
  elif command -v podman >/dev/null; then
    ok "podman $(podman --version | awk '{print $3}')"
  else
    warn "no working Docker/Podman: only needed for container workflows (see GUIDE.md)"
  fi
  for tool in claude codex opencode; do
    if command -v "$tool" >/dev/null; then ok "$tool CLI"; else warn "$tool CLI not installed"; fi
  done
  for tool in code cursor; do
    if command -v "$tool" >/dev/null; then ok "$tool command"; else warn "$tool command not on PATH"; fi
  done
  printf '\nKit: %s (%s)\n' "$kit_root" "$(git -C "$kit_root" rev-parse --short HEAD 2>/dev/null || echo 'not a git clone')"
  if [[ $failures -gt 0 ]]; then
    printf '%d required check(s) failed.\n' "$failures"
    return 1
  fi
  printf 'All required checks passed.\n'
}

command_name="${1:-help}"
[[ $# -gt 0 ]] && shift
case "$command_name" in
  new) command_new "$@" ;;
  list) command_list ;;
  open) command_open "$@" ;;
  migrate) command_migrate "$@" ;;
  doctor) command_doctor ;;
  update)
    git -C "$kit_root" pull --ff-only
    printf 'Kit updated. Existing Control Centers are separate repos and were not changed.\n'
    ;;
  help | -h | --help)
    usage
    printf '\nYour Control Centers:\n'
    command_list
    ;;
  *)
    printf 'error: unknown command: %s\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
