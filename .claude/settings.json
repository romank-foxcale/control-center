{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./cc help)",
      "PowerShell(.\\cc.cmd help)",
      "Bash(./cc show:*)",
      "PowerShell(.\\cc.cmd show:*)",
      "Bash(./cc validate)",
      "PowerShell(.\\cc.cmd validate)",
      "Bash(./cc doctor)",
      "PowerShell(.\\cc.cmd doctor)",
      "Bash(./cc agents check)",
      "PowerShell(.\\cc.cmd agents check)",
      "Bash(./cc repo list)",
      "PowerShell(.\\cc.cmd repo list)",
      "Bash(./cc repo show:*)",
      "PowerShell(.\\cc.cmd repo show:*)",
      "Bash(./cc plan list)",
      "PowerShell(.\\cc.cmd plan list)",
      "Bash(./cc plan show:*)",
      "PowerShell(.\\cc.cmd plan show:*)",
      "Bash(./cc worktree status:*)",
      "PowerShell(.\\cc.cmd worktree status:*)",
      "Bash(./cc bootstrap validate)",
      "PowerShell(.\\cc.cmd bootstrap validate)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/cc\" hook pre-bash",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/cc\" hook pre-read",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/cc\" hook pre-edit",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/cc\" hook post-edit",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/cc\" hook post-read",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/cc\" hook stop",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/cc\" hook session-start",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
